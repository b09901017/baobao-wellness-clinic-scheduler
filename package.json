{
  "name": "baobao-wellness-clinic-scheduler",
  "private": true,
  "type": "module",
  "description": "健康管理師排課系統。刻意沒有執行期相依套件，也沒有 build 步驟；devDependencies 只有測試與維運腳本用得到。",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:rules": "firebase emulators:exec --project demo-rules-test --only firestore \"node --test tests-e2e/rules/*.test.js\"",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:related": "node scripts/e2e.mjs --related",
    "test:e2e:smoke": "node scripts/e2e.mjs --smoke",
    "test:e2e:watch": "node scripts/e2e.mjs --watch",
    "verify": "node --test \"tests/*.test.js\" && node scripts/e2e.mjs --related",
    "emulators": "bash tests-e2e/start-emulators.sh",
    "restore": "node scripts/restore-backup.mjs",
    "seed:staging": "node scripts/seed-staging.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.28.2",
    "sharp": "^0.35.4"
  }
}
