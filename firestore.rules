rules_version = '2';

// 這是真正的安全防線。前端可以被繞過，這裡不行。
// 判準只有一條：沒登入、不在白名單的人，查不到任何一筆資料。
//
// 白名單怎麼加：在 Firebase Console 的 Firestore 手動新增一份文件
//   allowedUsers/{你的 uid}   內容可以是空的 {}
// uid 在 Authentication 分頁找得到。沒有這一步，登入了也讀不到東西。

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用判斷 ----------

    function signedIn() {
      return request.auth != null;
    }

    function allowed() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    // 永不硬刪除：刪除只能是寫入 deletedAt 時間戳。
    // 這條規則存在的意義是「就算程式寫錯了也刪不掉」。
    function keepsExistingId() {
      return request.resource.data.keys().hasAll(['updatedAt']);
    }

    // ---------- 白名單本身 ----------
    // 只能讀自己那一筆（規則裡的 exists() 不受這條限制）。
    // 新增與移除一律走 Firebase Console，程式不能改。
    match /allowedUsers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- 稽核紀錄 ----------
    // append-only：寫得進去，改不了也刪不掉。
    // 這是出事時唯一能回溯的東西，所以它必須比其他資料更難動。
    match /audit/{eventId} {
      allow read:   if allowed();
      allow create: if allowed()
                    && request.resource.data.actor == request.auth.uid
                    && request.resource.data.keys().hasAll(['at', 'actor', 'action', 'targetPath']);
      allow update, delete: if false;
    }

    // ---------- 主檔 ----------
    match /config/{docId=**} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId();
      allow delete: if false;
    }

    // ---------- 客戶與其子集合 ----------
    // 前端擋一次、這裡再擋一次（SPEC 第 6.7 節）。前端可以被繞過，這裡不行。
    //
    // 子集合刻意逐個列出而不用 /{sub=**}：萬用比對會與底下的具體規則
    // 「或」在一起，讓嚴格的那條形同虛設。第 6 步的 availability 要用時，
    // 回來這裡再開一個 match。
    function validCustomer() {
      let d = request.resource.data;
      return d.name is string
        && d.name.size() > 0
        && (!d.keys().hasAny(['priority'])
            || (d.priority is int && d.priority >= 0 && d.priority <= 5));
    }

    function validEntitlement() {
      let d = request.resource.data;
      return d.label is string
        && d.label.size() > 0
        && d.type in ['single', 'pool']
        && d.totalQty is int
        && d.totalQty > 0;
    }

    match /customers/{customerId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validCustomer();
      allow delete: if false;

      match /entitlements/{entitlementId} {
        allow read:   if allowed();
        allow create, update: if allowed() && keepsExistingId() && validEntitlement();
        allow delete: if false;
      }
    }

    // ---------- 來訪 ----------
    // 沒有 draft：app 裡不存在還沒壓表的來訪（SPEC 第 4.1 節）。
    // 狀態機的合法轉移在前端擋（domain/visits.js）—— 這裡只擋「根本不是一筆來訪」的東西，
    // 因為 Rules 讀 resource.data 判斷轉移會讓每次寫入多一次讀取，代價不划算。
    function validVisit() {
      let d = request.resource.data;
      return d.customerId is string
        && d.customerId.size() > 0
        && d.date is string
        && d.date.size() == 10
        && d.slots is list
        && d.slots.size() > 0
        && d.status in ['pending_confirm', 'confirmed', 'done', 'no_show', 'cancelled'];
    }

    match /visits/{visitId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validVisit();
      allow delete: if false;
    }

    // ---------- 任務 ----------
    match /tasks/{taskId} {
      allow read:   if allowed();
      allow create, update: if allowed();
      allow delete: if false;
    }

    // ---------- 壓表批次 ----------
    match /batches/{batchId} {
      allow read:   if allowed();
      allow create, update: if allowed();
      allow delete: if false;
    }

    // ---------- 其餘一律拒絕 ----------
    // 沒有明確允許的路徑就是不能碰。新增集合時要回來這裡開洞，
    // 這是刻意的：忘記開規則會壞掉，但不會外洩。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
