rules_version = '2';

// 這是真正的安全防線。前端可以被繞過，這裡不行。
// 判準只有一條：沒登入、不在白名單的人，查不到任何一筆資料。
//
// 白名單怎麼加：在 Firebase Console 的 Firestore 手動新增一份文件
//   allowedUsers/{你的 uid}   內容可以是空的 {}
// uid 在 Authentication 分頁找得到。沒有這一步，登入了也讀不到東西。

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用判斷 ----------

    function signedIn() {
      return request.auth != null;
    }

    function allowed() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    // 永不硬刪除：刪除只能是寫入 deletedAt 時間戳。
    // 這條規則存在的意義是「就算程式寫錯了也刪不掉」。
    function keepsExistingId() {
      return request.resource.data.keys().hasAll(['updatedAt']);
    }

    // ---------- 白名單本身 ----------
    // 只能讀自己那一筆（規則裡的 exists() 不受這條限制）。
    // 新增與移除一律走 Firebase Console，程式不能改。
    match /allowedUsers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- 稽核紀錄 ----------
    // append-only：寫得進去，改不了也刪不掉。
    // 這是出事時唯一能回溯的東西，所以它必須比其他資料更難動。
    match /audit/{eventId} {
      allow read:   if allowed();
      allow create: if allowed()
                    && request.resource.data.actor == request.auth.uid
                    && request.resource.data.keys().hasAll(['at', 'actor', 'action', 'targetPath']);
      allow update, delete: if false;
    }

    // ---------- 主檔 ----------
    match /config/{docId=**} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId();
      allow delete: if false;
    }

    // ---------- 客戶與其子集合 ----------
    // 前端擋一次、這裡再擋一次（SPEC 第 6.7 節）。前端可以被繞過，這裡不行。
    //
    // 子集合刻意逐個列出而不用 /{sub=**}：萬用比對會與底下的具體規則
    // 「或」在一起，讓嚴格的那條形同虛設。
    // 備註（marks）只驗形狀。長度與重複由 domain/customerMarks.js 擋在寫進去之前 ——
    // 那是「畫面掃不完」的問題，不是資料正確性問題。見 ADR-0019。
    function validCustomer() {
      let d = request.resource.data;
      return d.name is string
        && d.name.size() > 0
        && (!d.keys().hasAny(['priority'])
            || (d.priority is int && d.priority >= 0 && d.priority <= 5))
        && (!d.keys().hasAny(['marks']) || d.marks is list)
        // 合作機構（ADR-0076）。跟 marks 同一個深度：只驗形狀。
        // 裡面那幾個字對不對得上主檔不驗 —— 客戶身上存的是字串，
        // 而主檔改名之後那個字照樣要留著（同永久限制）。
        && (!d.keys().hasAny(['partners']) || d.partners is list);
    }

    // 原文是最終依據（SPEC 第 4.3 節），所以它不可以是空的 ——
    // 解析出來的 rules 錯了還有原文可以看，原文沒了就什麼都不剩。
    function validAvailability() {
      let d = request.resource.data;
      return d.rawText is string
        && d.rawText.size() > 0
        && d.validFrom is string
        && d.validTo is string
        && d.validTo >= d.validFrom
        && d.rules is list;
    }

    // 二返額度指回它是哪一筆健檢配出來的（followupForEntitlementId）。
    // 只驗形狀：指到一筆不存在的額度要靠 get() 才驗得出來，而那是每次寫入
    // 多一次讀取；指歪了的後果是配對比對失敗，資料健檢的「二返額度」那一項
    // 會把它列成還沒配對，不是資料外洩。見 ADR-0022。
    function validEntitlement() {
      let d = request.resource.data;
      return d.label is string
        && d.label.size() > 0
        // product 是營養品（ADR-0057）：一樣是一筆額度，只是排不進來訪。
        // 「它要有 productId」那一條在 domain/entitlements.js 的
        // validateEntitlement() 擋，這裡只驗形狀 —— 同 followupForEntitlementId。
        && d.type in ['single', 'pool', 'product']
        && d.totalQty is int
        && d.totalQty > 0
        && (!d.keys().hasAny(['followupForEntitlementId'])
            || d.followupForEntitlementId == null
            || d.followupForEntitlementId is string)
        // 健檢的金額等級（ADR-0054）。選填，只影響顯示名稱。
        && (!d.keys().hasAny(['tier'])
            || d.tier == null
            || (d.tier is string && d.tier.size() <= 20))
        // 哪一個營養點滴品項／哪一款營養品（ADR-0057）。兩個都選填，
        // 都只影響顯示名稱 —— 流程與任務一行都不看它們。
        && (!d.keys().hasAny(['ivProductId'])
            || d.ivProductId == null
            || d.ivProductId is string)
        && (!d.keys().hasAny(['productId'])
            || d.productId == null
            || d.productId is string)
        // 一次購買的營養品有好幾款、一個金額、還有「哪天給了哪些」的紀錄。
        // 這裡一樣只驗形狀 —— 裡面每一款指不指得到主檔在
        // domain/products.js 的 validateProduct() 擋。
        && (!d.keys().hasAny(['items']) || d.items == null || d.items is list)
        && (!d.keys().hasAny(['amountTwd'])
            || d.amountTwd == null
            || (d.amountTwd is int && d.amountTwd > 0))
        && (!d.keys().hasAny(['deliveries']) || d.deliveries == null || d.deliveries is list)
        // 一次購買的 id 與「方案本來寫幾次」。兩個都是選填 —— 2026-09-06
        // 之前建的那幾筆身上沒有，而「買過什麼」那一頁對它們有退路。
        && (!d.keys().hasAny(['purchaseId'])
            || d.purchaseId == null
            || d.purchaseId is string)
        && (!d.keys().hasAny(['sourcePlanQty'])
            || d.sourcePlanQty == null
            || (d.sourcePlanQty is int && d.sourcePlanQty > 0))
        // 買了幾套（`expandPlan()` 的快照，ADR-0090）。同 sourcePlanQty 那一條。
        && (!d.keys().hasAny(['sourcePlanSets'])
            || d.sourcePlanSets == null
            || (d.sourcePlanSets is int && d.sourcePlanSets > 0));
    }

    match /customers/{customerId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validCustomer();
      allow delete: if false;

      match /entitlements/{entitlementId} {
        allow read:   if allowed();
        allow create, update: if allowed() && keepsExistingId() && validEntitlement();
        allow delete: if false;
      }

      match /availability/{collectionId} {
        allow read:   if allowed();
        allow create, update: if allowed() && keepsExistingId() && validAvailability();
        allow delete: if false;
      }
    }

    // 「已刪除項目」要跨客戶找回被刪掉的收集，那是 collection group 查詢，
    // 跟 entitlements 一樣要另外開一條，只開 read。
    match /{path=**}/availability/{collectionId} {
      allow read: if allowed();
    }

    // 客戶總覽要一次拿到全部客戶的額度，用的是 collection group 查詢
    // （repo.listGroup('entitlements')）。Firestore 有一條很容易踩的規定：
    // 上面那個巢狀的 match 不會授權 collection group 查詢，一定要另外用
    // 遞迴萬用路徑再開一條，否則整個查詢會被拒，畫面上只看得到
    // 「Missing or insufficient permissions」。
    //
    // 只開 read。寫入仍然只能走上面那條具體路徑，所以 validEntitlement()
    // 不會被這條繞過去 —— 這正是上面那段註解在擔心的事。
    match /{path=**}/entitlements/{entitlementId} {
      allow read: if allowed();
    }

    // ---------- 來訪 ----------
    // 沒有 draft：app 裡不存在還沒壓表的來訪（SPEC 第 4.1 節）。
    // 這裡只擋「根本不是一筆來訪」的東西。狀態機的合法轉移刻意不在這裡擋 ——
    // 復原（SPEC 第 6.3 節）就是把舊值寫回去，那必然是一次反向轉移，
    // 擋了反向轉移就等於擋掉復原。見
    // docs/adr/0006-status-transitions-are-not-enforced-in-rules.md
    function validVisit() {
      let d = request.resource.data;
      return d.customerId is string
        && d.customerId.size() > 0
        && d.date is string
        && d.date.size() == 10
        && d.slots is list
        && d.slots.size() > 0
        && d.status in ['pending_confirm', 'confirmed', 'done', 'no_show', 'cancelled'];
    }

    match /visits/{visitId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validVisit();
      allow delete: if false;
    }

    // ---------- 任務 ----------
    // 任務幾乎都是來訪存檔時連帶產生的，但她也可以手動加一筆獨立待辦，
    // 所以 visitId 允許是 null。
    function validTask() {
      let d = request.resource.data;
      return d.customerId is string
        && d.kind is string
        && d.kind.size() > 0
        && d.dueDate is string
        && d.dueDate.size() == 10
        && d.done is bool
        // 取消類的待辦收的是哪幾段（`domain/taskRules.js` 的 `cancelTasksFor()`）。
        // 選填：只有取消類有，而且 2026-09-13 之前的沒有。這一層只擋形狀。
        && (!('slotIndexes' in d) || d.slotIndexes is list);
    }

    match /tasks/{taskId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validTask();
      allow delete: if false;
    }

    // ---------- 個人行程 ----------
    // 公出、休假、演講。不綁客戶、不產生任務、不扣次數，而且是唯一可以跨天的
    // 資料 —— 來訪的定義是「客戶某一天到院一次」，跨天的來訪不存在。
    // 為什麼不跟 visits 合成一個集合，見
    // docs/adr/0015-calendar-is-a-first-class-surface.md
    //
    // 這裡刻意連 endDate >= startDate 都擋：日曆上一條倒著長的色條會讓整個
    // 月檢視的排版算錯，而那種資料看畫面看不出是資料壞了還是排版壞了。
    function validEvent() {
      let d = request.resource.data;
      return d.title is string
        && d.title.size() > 0
        && d.category in ['personal', 'leave']
        && d.startDate is string
        && d.startDate.size() == 10
        && d.endDate is string
        && d.endDate.size() == 10
        && d.endDate >= d.startDate
        && d.allDay is bool
        // 她自己挑的顏色（ADR-0040）。選填，所以「沒有這個欄位」是對的；
        // 有的話擋掉形狀不對的。認得哪幾個名字是 domain 的事，
        // Rules 這裡只擋「連字串都不是」—— 這一層守的是形狀，不是詞彙表。
        && (!('color' in d) || d.color == null || d.color is string);
    }

    match /events/{eventId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validEvent();
      allow delete: if false;
    }

    // ---------- 隨手記 ----------
    // 客人的零碎小要求。沒有死線，所以它不是任務。
    // customerId 允許是 null —— 沒掛人的雜事通常是最容易忘的那些。
    function validNote() {
      let d = request.resource.data;
      return d.text is string
        && d.text.size() > 0
        && d.text.size() <= 200
        && d.done is bool
        // 選填的日期。掛了就會出現在日曆上（ADR-0044）。
        // 這一層只擋型別，格式在前端擋（SPEC 第 6.7 節）。
        && (!('date' in d) || d.date == null || d.date is string);
    }

    match /notes/{noteId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validNote();
      allow delete: if false;
    }

    // ---------- 備忘錄／SOP ----------
    //
    // 她自己整理的流程與心得。綁課程不綁人，不會變成待辦（ADR-0067）。
    //
    // 跟 validNote() 同一個深度：**只擋型別與大小**。逐節的內容在前端擋
    //（`domain/playbook.js` 的 `validatePlaybook()`，SPEC 第 6.7 節的雙層驗證）
    // —— Rules 讀不進巢狀陣列的每一格而不多付一大筆規則複雜度，
    // 而 validVisit() 對 slots 做過同一個判斷。
    // 三個欄位：標題、掛哪些課程、一大塊字（ADR-0069）。
    // 章節、分類、釘選是 2026-09-04 拿掉的 —— 舊形狀寫不進來是對的，
    // 那一版只活在她本機的模擬器裡。
    function validPlaybook() {
      let d = request.resource.data;
      return d.title is string
        && d.title.size() > 0
        && d.title.size() <= 40
        && d.body is string
        && d.body.size() > 0
        && d.body.size() <= 5000
        && (!('courseIds' in d) || d.courseIds is list)
        // 掛哪幾家合作機構（ADR-0076）。同上，只驗形狀 ——
        // 存的是字串（跟客戶身上一樣），對不對得上主檔不驗。
        && (!('partners' in d) || d.partners is list);
    }

    match /playbooks/{playbookId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validPlaybook();
      allow delete: if false;
    }

    // ---------- 壓表批次 ----------
    // queue **的順序**在建立當下凍結（ADR-0001 的 Consequences）。之後改得動
    // 三樣：每一筆的 state、cursor，以及**接在最後面的新成員**（2026-09-09，
    // ADR-0083 那一輪的 `mergeIntoQueue()` —— 開批之後才新增的客人以前
    // 永遠進不來）。新成員身上多一格 `joinedLate`。
    // 這裡只驗形狀（`queue is list`），所以那一格不需要開洞。
    // 這裡不驗證順序沒被動過 —— Rules 讀不到「之前是什麼順序」而不多做一次讀取，
    // 而順序跳掉的後果是她要重新找位置，不是資料錯誤。
    //
    // 沒有 courseId：一批是一個月的一串客戶，不是一個課程，見
    // docs/adr/0014-scheduling-is-per-customer-not-per-course.md
    function validBatch() {
      let d = request.resource.data;
      return d.targetMonth is string
        && d.targetMonth.size() == 7
        && d.queue is list
        && d.status in ['active', 'finished', 'abandoned'];
    }

    match /batches/{batchId} {
      allow read:   if allowed();
      allow create, update: if allowed() && keepsExistingId() && validBatch();
      allow delete: if false;
    }

    // ---------- 客戶自己填的時間 ----------
    //
    // 這是整份 Rules 裡**唯一讓沒有登入的人寫得進來**的地方，所以它比其他集合都緊。
    // 設計與四道限制見 docs/adr/0031-the-customer-form-is-its-own-page.md 與
    // .scratch/customer-availability-form/spec.md 第 6 節。
    //
    // 客戶手上唯一的鑰匙是 token，也就是文件 id：Firestore 自動 id，
    // 20 個字元、62 種字元，猜不到。

    function inviteOf(token) {
      return get(/databases/$(database)/documents/formInvites/$(token)).data;
    }

    function validInvite() {
      let d = request.resource.data;
      return d.customerId is string
        && d.month is string
        && d.month.size() == 7
        && d.validFrom is string
        && d.validTo is string
        // Rules 沒辦法把 'YYYY-MM-DD' 跟 request.time 比大小，所以過期靠這個時間戳
        && d.expiresAt is timestamp;
    }

    match /formInvites/{token} {
      // **get 與 list 分開，這是這一段最容易寫錯的地方。** 兩個都寫成
      // allow read 的話，任何人都可以一次查出全部邀請 —— 而邀請上有客戶的名字。
      // 拿得到 token 才讀得到那一份，是客戶本人要知道「這是誰的、問哪個月」。
      allow get:  if true;
      allow list: if allowed();
      allow create, update: if allowed() && keepsExistingId() && validInvite();
      allow delete: if false;
    }

    // 客戶送出的答案。**id 就是 token —— 一條連結只有一份答案。**
    //
    // 「暫時不重填」是這條 Rules 保證的，不是前端擋的：第二次送出在 Firestore
    // 眼中是 update，而客戶沒有 update 的權限。前端擋是體貼，這裡擋才算數。
    //
    // 前端送什麼過來都繞不過 customerId 與 month —— 它們是拿邀請本身比對的，
    // 不是信任 request 裡的值。
    function validNewResponse(token) {
      let d = request.resource.data;
      return exists(/databases/$(database)/documents/formInvites/$(token))
        && inviteOf(token).deletedAt == null
        && request.time < inviteOf(token).expiresAt
        && d.keys().hasOnly(['token', 'customerId', 'customerName', 'month',
                             'weekdays', 'dates', 'freeText',
                             'submittedAt', 'takenAt', 'deletedAt'])
        && d.token == token
        && d.customerId == inviteOf(token).customerId
        && d.month == inviteOf(token).month
        && d.weekdays is list
        && d.weekdays.size() <= 14
        && d.dates is list
        && d.dates.size() <= 45
        && d.freeText is string
        && d.freeText.size() <= 500
        // 名字只是顯示用（資料歸屬看的是上面拿邀請比對的 customerId），
        // 但它沒有型別與上限的話，這裡就是整份 Rules 唯一一個
        // 沒登入的人可以塞任意型別、任意大小的欄位 —— 兄弟欄位全都擋了。
        && d.customerName is string
        && d.customerName.size() <= 100
        // **送出時間由伺服器決定。** 客戶端寫的是 serverTimestamp()，
        // 在 Rules 眼中就等於 request.time；比對它等於不接受客戶端自己指定的值。
        // 這個欄位不是裝飾：收件匣把「什麼時候填的」印出來，而她要靠它判斷
        // 這一份是不是在她壓完那個月的表之後才回來的。
        && d.submittedAt == request.time
        && d.takenAt == null
        // 沒有這個欄位她的收件匣一筆都看不到 —— repo.list() 一律用
        // where('deletedAt','==',null) 過濾。
        && d.deletedAt == null;
    }

    match /formResponses/{token} {
      // 拿得到 token 的人就是客戶本人，他重開連結時看得到自己填了什麼。
      // list 一樣關著 —— 收件匣是她的。
      allow get:  if true;
      allow list: if allowed();
      allow create: if validNewResponse(token);
      // 收下（takenAt）與丟掉（deletedAt）都只有她做得到。
      allow update: if allowed() && keepsExistingId();
      allow delete: if false;
    }

    // ---------- 其餘一律拒絕 ----------
    // 沒有明確允許的路徑就是不能碰。新增集合時要回來這裡開洞，
    // 這是刻意的：忘記開規則會壞掉，但不會外洩。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
